# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Large binary / data files
*.zip
*.npy
*.faiss
*.parquet
*.mp4
*.tar
*.gz

# Ignore data folder contents but preserve structure via .gitkeep
raw/**
!raw/.gitkeep
!raw/**/.gitkeep
!raw/**/AIC2026_BTC_Data_Structure.md

data/**
!data/.gitkeep
!data/**/.gitkeep
!data/benchmark/**

indexes/**
!indexes/.gitkeep
!indexes/**/.gitkeep

outputs/**
!outputs/.gitkeep
!outputs/**/.gitkeep

backups/**
!backups/.gitkeep
!backups/**/.gitkeep

# Large Media & Keyframe Folders added by user
Keyframes/
keyframes/
Keyframes_*/
Keyframes*/
Videos/
videos/
Videos_*/
Videos*/

# Virtual environments
venv/
env/
.env
.venv
AIC2026/

# Temporary Scratch / Video cache
scratch/

# Pytest & IDEs
.pytest_cache/
.coverage
.idea/
.vscode/
*.swp
